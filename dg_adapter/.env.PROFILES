# Adapter defaults; override in <scenario>/common/heo_seed_control/.env.PROFILES.
PROFILE_SEED=20261013
# fixed: use PROFILE_SEED; random: choose a fresh PROFILE_SEED when optimization starts.
PROFILE_SEED_MODE=fixed
PROFILE_WORKERS=1
# generate: calculate profiles; saved: load DG CSV profiles without regeneration.
PROFILE_MODE=generate
# In saved mode: absolute path or path relative to the scenario, to DG's demands folder.
PROFILE_SOURCE=
